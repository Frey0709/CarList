<Window x:Class="CarList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarList"
        mc:Ignorable="d"
        Title="Car Inventory" WindowStartupLocation="CenterScreen" MinHeight="410" MinWidth="350" Height="470" Width="500">
    <Grid>

        <!-- Main TabControl -->
        <TabControl x:Name="tabControlMain" SelectionChanged="TabControl_SelectionChanged" Margin="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

            <!-- Tab 1: Add Vehicles -->
            <TabItem Header="Add Vehicles">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Vehicle Type -->
                        <Label Content="_Type:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <ComboBox x:Name="comboVehicleType" Grid.Row="0" Grid.Column="1" Width="120" Margin="5" SelectedIndex="0" ToolTip="Select the type of vehicle">
                            <ComboBoxItem Content="Car"/>
                            <ComboBoxItem Content="Motorcycle"/>
                        </ComboBox>

                        <!-- Make -->
                        <Label Content="_Make:" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <ComboBox x:Name="comboMake" Grid.Row="1" Grid.Column="1" Width="120" Margin="5" ToolTip="Select the manufacturer of the vehicle">
                            <ComboBoxItem Content="BMW"/>
                            <ComboBoxItem Content="Honda"/>
                            <ComboBoxItem Content="Hyundai"/>
                            <ComboBoxItem Content="Ford"/>
                            <ComboBoxItem Content="Dodge"/>
                            <ComboBoxItem Content="Ferrari"/>
                            <ComboBoxItem Content="Porshe"/>
                            <ComboBoxItem Content="Rolls Royce"/>
                            <ComboBoxItem Content="Kia"/>
                            <ComboBoxItem Content="Lamborghini"/>
                            <ComboBoxItem Content="DMC"/>
                        </ComboBox>

                        <!-- Model -->
                        <Label Content="M_odel:" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBox x:Name="textModel" Grid.Row="2" Grid.Column="1" Margin="5" ToolTip="Enter the model of the vehicle"/>

                        <!-- Year -->
                        <Label Content="_Year:" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <ComboBox x:Name="comboYear" Grid.Row="3" Grid.Column="1" Width="120" Margin="5" ToolTip="Select the year of the vehicle"/>

                        <!-- Price -->
                        <Label Content="_Price:" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBox x:Name="textPrice" Grid.Row="4" Grid.Column="1" Margin="5" ToolTip="Enter the price of the vehicle"/>

                        <!-- Is New -->
                        <CheckBox x:Name="checkIsNew" Grid.Row="5" Grid.Column="1" Content="_New?" HorizontalAlignment="Left" Margin="5"/>
                    </Grid>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <Button x:Name="buttonEnter" Content="_Enter" MinWidth="60" Margin="5" Click="EnterClick" ToolTip="Click to enter your vehicle"/>
                        <Button x:Name="buttonReset" Content="_Reset" MinWidth="60" Margin="5" Click="ResetClick" ToolTip="Click to reset the form"/>
                        <Button x:Name="buttonExit" Content="E_xit" MinWidth="60" Margin="5" Click="ExitClick" ToolTip="Click to exit the program"/>
                    </StackPanel>

                    <!-- Output box for messages -->
                    <TextBox x:Name="textOutput" IsReadOnly="True" MinHeight="50" Background="LightGray" Margin="3" ToolTip="Displays output messages"/>
                </StackPanel>
            </TabItem>

            <!-- Tab 2: Vehicle List -->
            <TabItem Header="Vehicle List">
                <ListView x:Name="listViewCars" Margin="5" MinHeight="150" SelectionChanged="CarSelect">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding Type}" Width="80" Header="Type"/>
                            <GridViewColumn DisplayMemberBinding="{Binding IdentificationNumber}" Width="40" Header="ID"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Make}" Width="100" Header="Make"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Model}" Width="100" Header="Model"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Year}" Width="50" Header="Year"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Price}" Width="70" Header="Price"/>
                            <GridViewColumn DisplayMemberBinding="{Binding IsNew}" Width="50" Header="New?"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <!-- Tab 3: Statistics -->
            <TabItem Header="Statistics">
                <StackPanel Margin="10">
                    <Label x:Name="labelTotalVehicles" Content="Total Vehicles: 0" Margin="3"/>
                    <Label x:Name="labelTotalPrice" Content="Total Price: $0" Margin="3"/>
                    <Label x:Name="labelAveragePrice" Content="Average Price: $0" Margin="3"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar VerticalAlignment="Bottom" Height="25">
            <StatusBarItem HorizontalAlignment="Stretch">
                <TextBlock x:Name="statusMessage" Text="No Status to report"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>